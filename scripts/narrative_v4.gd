static func wave_lines(wave: int, stage: String = "start") -> Array:
	return WAVES.get(str(wave), {}).get(stage, []).duplicate(true)

static func wave_name(wave: int) -> String:
	return str(WAVES.get(str(wave), {}).get("name", "未知战区"))

static func bark(id: String) -> Array:
	var aliases = {"turret":"deploy_turret", "baneling":"baneling_chain", "lurker":"lurker_kill", "revive":"last_stand", "stimpack":"stim"}
	return BARKS.get(aliases.get(id,id), []).duplicate(true)

static func shop(context: Dictionary = {}) -> Array:
	var key = str(context.get("channel", ""))
	if key == "":
		if int(context.get("rerolls",0)) >= 3: key="reroll"
		elif float(context.get("hp",100))/maxf(1,float(context.get("max_hp",100))) < 0.3: key="low_hp"
		elif int(context.get("cash",0))>400: key="rich"
		elif float(context.get("hp",100))>=float(context.get("max_hp",100)): key="full_hp"
		else: key="hank"
	return SHOPS.get(key,SHOPS.hank).duplicate(true)

static func bridge(id: String = "welcome") -> Array:
	return BRIDGE.get(id, BRIDGE.welcome).duplicate(true)
